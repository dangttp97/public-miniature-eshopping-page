{
  "mappings": [
    {
      "priority": 1,
      "request": {
        "method": "POST",
        "urlPath": "/api/auth/check",
        "bodyPatterns": [{ "matchesJsonPath": "$[?(@.email in ['an@example.vn', 'binh@example.vn'])]" }]
      },
      "response": { "status": 200, "headers": { "Content-Type": "application/json" }, "jsonBody": { "exists": true } }
    },
    {
      "priority": 2,
      "request": {
        "method": "POST",
        "urlPath": "/api/auth/check",
        "customMatcher": { "name": "state-matcher", "parameters": { "hasContext": "user:{{jsonPath request.body '$.email'}}" } }
      },
      "response": { "status": 200, "headers": { "Content-Type": "application/json" }, "jsonBody": { "exists": true } }
    },
    {
      "priority": 3,
      "request": { "method": "POST", "urlPath": "/api/auth/check", "bodyPatterns": [{ "matchesJsonPath": "$.email" }] },
      "response": { "status": 200, "headers": { "Content-Type": "application/json" }, "jsonBody": { "exists": false } }
    },

    {
      "priority": 1,
      "request": {
        "method": "POST",
        "urlPath": "/api/auth/login",
        "bodyPatterns": [{ "equalToJson": { "email": "an@example.vn", "password": "matkhau123" } }]
      },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "body": "{ \"user\": { \"id\": \"u-1001\", \"name\": \"Nguyễn Văn An\", \"email\": \"an@example.vn\" }, \"token\": \"{{randomValue length=32 type='ALPHANUMERIC'}}\" }"
      },
      "serveEventListeners": [
        {
          "name": "recordState",
          "parameters": {
            "context": "session:{{jsonPath response.body '$.token'}}",
            "state": { "userId": "u-1001", "name": "Nguyễn Văn An", "email": "an@example.vn" }
          }
        }
      ]
    },
    {
      "priority": 1,
      "request": {
        "method": "POST",
        "urlPath": "/api/auth/login",
        "bodyPatterns": [{ "equalToJson": { "email": "binh@example.vn", "password": "123456" } }]
      },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "body": "{ \"user\": { \"id\": \"u-1002\", \"name\": \"Trần Thị Bình\", \"email\": \"binh@example.vn\" }, \"token\": \"{{randomValue length=32 type='ALPHANUMERIC'}}\" }"
      },
      "serveEventListeners": [
        {
          "name": "recordState",
          "parameters": {
            "context": "session:{{jsonPath response.body '$.token'}}",
            "state": { "userId": "u-1002", "name": "Trần Thị Bình", "email": "binh@example.vn" }
          }
        }
      ]
    },
    {
      "priority": 2,
      "request": {
        "method": "POST",
        "urlPath": "/api/auth/login",
        "customMatcher": {
          "name": "state-matcher",
          "parameters": {
            "hasContext": "user:{{jsonPath request.body '$.email'}}",
            "property": { "password": { "equalTo": "{{jsonPath request.body '$.password'}}" } }
          }
        }
      },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "body": "{ \"user\": { \"id\": \"{{state context=(join 'user:' (jsonPath request.body '$.email') '') property='id'}}\", \"name\": {{{toJson (state context=(join 'user:' (jsonPath request.body '$.email') '') property='name')}}}, \"email\": {{{toJson (jsonPath request.body '$.email')}}} }, \"token\": \"{{randomValue length=32 type='ALPHANUMERIC'}}\" }"
      },
      "serveEventListeners": [
        {
          "name": "recordState",
          "parameters": {
            "context": "session:{{jsonPath response.body '$.token'}}",
            "state": {
              "userId": "{{jsonPath response.body '$.user.id'}}",
              "name": "{{jsonPath response.body '$.user.name'}}",
              "email": "{{jsonPath response.body '$.user.email'}}"
            }
          }
        }
      ]
    },
    {
      "priority": 5,
      "request": {
        "method": "POST",
        "urlPath": "/api/auth/login",
        "bodyPatterns": [{ "matchesJsonPath": "$.email" }, { "matchesJsonPath": "$.password" }]
      },
      "response": {
        "status": 401,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": { "error": "Email hoặc mật khẩu không đúng" }
      }
    },

    {
      "priority": 1,
      "request": {
        "method": "POST",
        "urlPath": "/api/auth/register",
        "bodyPatterns": [{ "matchesJsonPath": "$[?(@.email in ['an@example.vn', 'binh@example.vn'])]" }]
      },
      "response": { "status": 409, "headers": { "Content-Type": "application/json" }, "jsonBody": { "error": "Email này đã được đăng ký" } }
    },
    {
      "priority": 1,
      "request": {
        "method": "POST",
        "urlPath": "/api/auth/register",
        "customMatcher": { "name": "state-matcher", "parameters": { "hasContext": "user:{{jsonPath request.body '$.email'}}" } }
      },
      "response": { "status": 409, "headers": { "Content-Type": "application/json" }, "jsonBody": { "error": "Email này đã được đăng ký" } }
    },
    {
      "priority": 2,
      "request": {
        "method": "POST",
        "urlPath": "/api/auth/register",
        "bodyPatterns": [{ "matchesJsonPath": "$[?(@.password =~ /^.{0,5}$/)]" }]
      },
      "response": { "status": 400, "headers": { "Content-Type": "application/json" }, "jsonBody": { "error": "Mật khẩu tối thiểu 6 ký tự" } }
    },
    {
      "priority": 3,
      "request": {
        "method": "POST",
        "urlPath": "/api/auth/register",
        "bodyPatterns": [{ "matchesJsonPath": "$.name" }, { "matchesJsonPath": "$.email" }, { "matchesJsonPath": "$.password" }]
      },
      "response": {
        "status": 201,
        "headers": { "Content-Type": "application/json" },
        "body": "{ \"user\": { \"id\": \"u-{{randomValue length=6 type='NUMERIC'}}\", \"name\": {{{toJson (jsonPath request.body '$.name')}}}, \"email\": {{{toJson (jsonPath request.body '$.email')}}} }, \"token\": \"{{randomValue length=32 type='ALPHANUMERIC'}}\" }"
      },
      "serveEventListeners": [
        {
          "name": "recordState",
          "parameters": {
            "context": "user:{{jsonPath request.body '$.email'}}",
            "state": {
              "id": "{{jsonPath response.body '$.user.id'}}",
              "name": "{{jsonPath request.body '$.name'}}",
              "email": "{{jsonPath request.body '$.email'}}",
              "password": "{{jsonPath request.body '$.password'}}"
            }
          }
        },
        {
          "name": "recordState",
          "parameters": {
            "context": "session:{{jsonPath response.body '$.token'}}",
            "state": {
              "userId": "{{jsonPath response.body '$.user.id'}}",
              "name": "{{jsonPath request.body '$.name'}}",
              "email": "{{jsonPath request.body '$.email'}}"
            }
          }
        }
      ]
    },

    {
      "priority": 1,
      "request": {
        "method": "GET",
        "urlPath": "/api/auth/me",
        "headers": { "Authorization": { "matches": "Bearer [A-Za-z0-9]+" } },
        "customMatcher": {
          "name": "state-matcher",
          "parameters": { "hasContext": "session:{{regexExtract request.headers.Authorization '[A-Za-z0-9]+$'}}" }
        }
      },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "body": "{ \"id\": \"{{state context=(join 'session:' (regexExtract request.headers.Authorization '[A-Za-z0-9]+$') '') property='userId'}}\", \"name\": {{{toJson (state context=(join 'session:' (regexExtract request.headers.Authorization '[A-Za-z0-9]+$') '') property='name')}}}, \"email\": \"{{state context=(join 'session:' (regexExtract request.headers.Authorization '[A-Za-z0-9]+$') '') property='email'}}\" }"
      }
    },
    {
      "priority": 1,
      "request": { "method": "POST", "urlPath": "/api/auth/logout", "headers": { "Authorization": { "matches": "Bearer [A-Za-z0-9]+" } } },
      "response": { "status": 204 },
      "serveEventListeners": [
        { "name": "deleteState", "parameters": { "context": "session:{{regexExtract request.headers.Authorization '[A-Za-z0-9]+$'}}" } }
      ]
    },

    {
      "priority": 9,
      "request": { "method": "GET", "urlPath": "/api/auth/me" },
      "response": {
        "status": 401,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": { "error": "Phiên đăng nhập đã hết hạn, vui lòng đăng nhập lại" }
      }
    },
    {
      "priority": 10,
      "request": { "method": "POST", "urlPathPattern": "/api/(auth/.*|orders)" },
      "response": { "status": 400, "headers": { "Content-Type": "application/json" }, "jsonBody": { "error": "Thiếu thông tin bắt buộc" } }
    }
  ]
}
